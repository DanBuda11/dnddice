{
  "name": "dnddice",
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "D&D Dice Rolling App",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanBuda11/dnddice.git"
  },
  "author": "Dan Buda",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DanBuda11/dnddice/issues"
  },
  "homepage": "https://github.com/DanBuda11/dnddice#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
